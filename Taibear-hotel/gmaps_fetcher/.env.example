# ── Required ──────────────────────────────────────────────────────────────────
# Google Maps Platform key (needs Places API + Distance Matrix API + Maps Photo API enabled)
GOOGLE_MAPS_API_KEY=your_maps_key_here

# ── Optional (only needed for Gemini caption generation) ──────────────────────
# Gemini API key(s) — add _2 / _3 for quota rotation
GOOGLE_API_KEY=your_gemini_key_here
# GOOGLE_API_KEY_2=
# GOOGLE_API_KEY_3=
