# .gitignore for YTP_Hackathon (Python + tools)
# Generated to ignore virtualenvs, build artifacts, IDE files,
# OS junk, and large scraped/output folders.

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
.pytest_cache/
nosetests.xml
coverage.xml
*,cover

# Translations
*.mo
*.pot

# IDEs and editors
.vscode/
*.code-workspace
.idea/
*.iml
*.sublime-project
*.sublime-workspace

# Virtual environments
.env
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Jupyter
.ipynb_checkpoints/

# IPython
profile_default/
ipython_config.py


# type check / language server caches
.mypy_cache/
.dmypy.json
.pyright/

# Logs and databases
*.log
*.sqlite3
*.db
*.db-journal

# OS generated files
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# Node
node_modules/
npm-debug.log*

# Scraped data & outputs (keep summary CSV)
cafe_results/*
!cafe_results/cafes_data.csv
results/
outputs/
tmp/
temp/
*.tmp

# Chinese-named data dump directories from scraper
咖啡廳_results/
餐廳_results/
餐酒_results/
臺北市立美術館_place/
臺北玫瑰園_place/
from_ruby/

# Secrets — never commit
.env
weather_auth_code

# Build artifacts
*.apk
*.aab

# Python bytecode
*.pyc
*.pyo
*.pyd

# Secrets / env
.env
*.key
*.pem
*.crt

# Lock files (optional)
Pipfile.lock
poetry.lock

# Swap / backup files
*.swp
*~

