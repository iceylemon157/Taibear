FROM python:3.11-slim

WORKDIR /app

# Install dependencies
RUN pip install --no-cache-dir \
    fastapi \
    uvicorn[standard] \
    pydantic \
    python-dotenv \
    requests \
    httpx

# Copy both trip_manager and realtime_monitor (trip_manager imports realtime_monitor)
COPY trip_manager/ ./trip_manager/
COPY realtime_monitor/ ./realtime_monitor/
COPY weather_auth_code ./weather_auth_code

# trip_manager uses fully-qualified imports (from trip_manager.xxx, from realtime_monitor.xxx)
# so WORKDIR must be the common parent.

EXPOSE 8003

CMD ["uvicorn", "trip_manager.main:app", "--host", "0.0.0.0", "--port", "8003"]
