# ══════════════════════════════════════════════════════════════════════════════
#  YTP Hackathon — Environment Variables
#  Copy this file to .env and fill in your keys.
# ══════════════════════════════════════════════════════════════════════════════

# ── Postgres (used by Trip Planning Agent + TG Bot) ───────────────────────────
POSTGRES_DB=ytp
POSTGRES_USER=ytp
POSTGRES_PASSWORD=changeme

# ── Trip Planning Agent (agent-api on port 8001) ─────────────────────────────
# Gemini API keys (at least one required; extras for quota rotation)
GOOGLE_API_KEY=
GOOGLE_API_KEY_2=
GOOGLE_API_KEY_3=
# Google Maps Platform key (Places API + Distance Matrix)
GOOGLE_MAPS_API_KEY=
# Self-generated API key for authenticating requests to the agent
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
YTP_API_KEY=

# ── Telegram Bot ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
APIFY_TOKEN=
GEMINI_API_KEY=
YOUTUBE_API_KEY=

# ── Realtime Monitor (used by Trip Manager) ──────────────────────────────────
# CWA weather API — leave blank to auto-read from weather_auth_code file
CWA_API_KEY=
# TDX traffic API (optional, stub for now)
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=
